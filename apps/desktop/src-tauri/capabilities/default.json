{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "deny": [{ "url": "mailto:*[?]*" }] },
    "opener:allow-default-urls",
    "notification:allow-is-permission-granted"
  ]
}
